# Copy to .env.local (dev) or set in Coolify (prod). Never commit real values.

# Public URL of this app, no trailing slash. Auth0 callbacks and the plugin's relay.url derive from it.
APP_BASE_URL=http://localhost:3000

# Auth0: a "Regular Web Application".
#   Allowed Callback URLs: http://localhost:3000/auth/callback, https://<your domain>/auth/callback
#   Allowed Logout URLs:   http://localhost:3000, https://<your domain>
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 random bytes as hex: openssl rand -hex 32
AUTH0_SECRET=
# Optional: the key relay tokens are derived from (openssl rand -hex 32). Without it, AUTH0_SECRET is used; changing
# whichever is used gives each server a new token on its next plugin download, and the installed jar stops working.
RELAY_SECRET=

# MySQL 8: mysql://user:password@host:3306/database
DATABASE_URL=

# Optional: the directory with the AIBuilder-<version>.jar offered at /download/AIBuilder.jar. The Docker image
# brings its own; a checkout uses ../plugin/core/build/libs.
# PLUGIN_JAR_DIR=

# Cloudflare R2: R2 > Manage API tokens > Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: megabytes of map tiles kept in memory (default 256).
# MAP_CACHE_MB=

# Optional: selling plans through Stripe (lib/server/billing.ts). Without STRIPE_SECRET_KEY the panel sells nothing and
# limits nothing. STRIPE_PRICE_PRO is the Pro price (price_...) or its product (prod_..., whose default price is used).
# STRIPE_WEBHOOK_SECRET signs POST /api/billing/webhook; STRIPE_PRICE_STUDIO names the Studio price once it is sold.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PRO=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STUDIO=

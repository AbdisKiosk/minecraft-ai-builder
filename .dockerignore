# The panel image (panel/Dockerfile) is built from the repository root: it needs panel/, plugin/ and the build skills
# the panel's chat reads (.claude/skills).
*
!panel
!plugin
!.claude
.claude/*
!.claude/skills

panel/node_modules
panel/.next
panel/dist
panel/.env*
!panel/.env.example
panel/test
panel/Dockerfile
panel/*.tsbuildinfo
panel/next-env.d.ts

plugin/.gradle
plugin/**/build
plugin/**/bin
plugin/**/run
plugin/**/src/test
plugin/**/.settings
plugin/**/.classpath
plugin/**/.project

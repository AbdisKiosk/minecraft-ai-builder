# Copy to .env.local (dev) or set in Coolify (prod). Never commit real values.

# Public URL of this app, no trailing slash. Auth0 callbacks and the plugin's relay.url derive from it.
APP_BASE_URL=http://localhost:3000

# Auth0: a "Regular Web Application".
#   Allowed Callback URLs: http://localhost:3000/auth/callback, https://<your domain>/auth/callback
#   Allowed Logout URLs:   http://localhost:3000, https://<your domain>
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 random bytes as hex: openssl rand -hex 32
AUTH0_SECRET=

# MySQL 8: mysql://user:password@host:3306/database
DATABASE_URL=

# Cloudflare R2: R2 > Manage API tokens > Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
